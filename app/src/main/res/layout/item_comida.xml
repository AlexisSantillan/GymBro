<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="8dp"
    app:cardCornerRadius="12dp"
    android:layout_margin="8dp"
    android:backgroundTint="#1C1C1C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/editTextNombreComida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de la comida"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#757575"
            android:backgroundTint="#D32F2F"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/editTextHorario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Seleccionar horario"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#757575"
            android:backgroundTint="#D32F2F"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/editTextCaloriasComida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Calorías"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#757575"
            android:backgroundTint="#D32F2F"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/buttonEliminarComida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eliminar"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
