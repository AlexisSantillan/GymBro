<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1C1C"
    tools:context=".PantallaInicioActivity">

    <!-- Directrices para manejar los márgenes dinámicamente -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="8dp"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="8dp"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="16dp"
        android:orientation="horizontal" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="16dp"
        android:orientation="horizontal" />

    <!-- Título GYMBRO centrado en la parte superior -->
    <TextView
        android:id="@+id/titleGymBro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GYMBRO"
        android:textSize="36sp"
        android:textColor="#FF0000"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <!-- Botón Rutina en la parte superior izquierda -->
    <androidx.cardview.widget.CardView
        android:id="@+id/rutinaButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/titleGymBro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/claseButton"
        app:layout_constraintBottom_toTopOf="@+id/dietaButton"
        app:layout_constraintWidth_percent="0.45"
        app:layout_constraintHeight_percent="0.4"
        app:cardBackgroundColor="#2E2E2E"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        android:layout_margin="8dp">

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="💪\nAgregar Rutina"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="8dp"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:onClick="openAgregarRutinaActivity"/>
    </androidx.cardview.widget.CardView>

    <!-- Botón Clase en la parte superior derecha -->
    <androidx.cardview.widget.CardView
        android:id="@+id/claseButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/titleGymBro"
        app:layout_constraintStart_toEndOf="@+id/rutinaButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/userButton"
        app:layout_constraintWidth_percent="0.45"
        app:layout_constraintHeight_percent="0.4"
        app:cardBackgroundColor="#2E2E2E"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        android:layout_margin="8dp">

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="📅\nAgregar Clase"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="8dp"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:onClick="openAgregarClasesActivity"/>
    </androidx.cardview.widget.CardView>

    <!-- Botón Dieta en la parte inferior izquierda -->
    <androidx.cardview.widget.CardView
        android:id="@+id/dietaButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/rutinaButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/userButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.45"
        app:layout_constraintHeight_percent="0.4"
        app:cardBackgroundColor="#2E2E2E"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        android:layout_margin="8dp">

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🍎\nAgregar Dieta"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="8dp"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:onClick="openAgregarDietaActivity"/>
    </androidx.cardview.widget.CardView>

    <!-- Botón Usuario en la parte inferior derecha -->
    <androidx.cardview.widget.CardView
        android:id="@+id/userButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/claseButton"
        app:layout_constraintStart_toEndOf="@+id/dietaButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.45"
        app:layout_constraintHeight_percent="0.4"
        app:cardBackgroundColor="#2E2E2E"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        android:layout_margin="8dp">

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="👤\nAgregar Usuario"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="8dp"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:onClick="openAgregarUsuarioActivity"/>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
